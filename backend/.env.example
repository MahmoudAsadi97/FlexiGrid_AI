# Local LLM (OpenAI-compatible endpoint; Ollama is the reference setup).
# Install Ollama (https://ollama.com), then:
#   ollama pull qwen2.5:3b-instruct
#   ollama pull nomic-embed-text
FLEXIGRID_LLM_BASE_URL=http://localhost:11434/v1
FLEXIGRID_LLM_MODEL=qwen2.5:3b-instruct
FLEXIGRID_LLM_API_KEY=ollama
FLEXIGRID_LLM_TIMEOUT=120

# Embeddings backend: auto | ollama | sbert | tfidf
# auto prefers Ollama (nomic-embed-text), then sentence-transformers,
# then the deterministic TF-IDF fallback (always available, no downloads).
FLEXIGRID_EMBEDDINGS=auto
FLEXIGRID_EMBED_MODEL=nomic-embed-text

# Elia Open Data: false = labelled frozen fixture (reproducible exam demo),
# true = fetch live ods002/ods086 records and derive the stress signal.
ELIA_USE_LIVE=false

# CORS origins for the dashboard dev server (comma-separated).
FLEXIGRID_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
